# ============================================
# CONFIGURAÇÕES DE PRODUÇÃO
# ============================================
# IMPORTANTE: NUNCA versionar este arquivo com valores reais!
# Copie este arquivo para .env.production e preencha com valores reais

APP_NAME="Minha Aplicação"
APP_ENV=production
APP_KEY=base64:GERAR_COM_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://seudominio.com.br

# ============================================
# BANCO DE DADOS
# ============================================
# Use senhas FORTES e ÚNICAS!
# Gere senhas com: openssl rand -base64 32

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=nome_do_banco_producao
DB_USERNAME=usuario_producao
DB_PASSWORD=senha_forte_aqui_minimo_32_caracteres

# Senha root do MySQL (use senha diferente da aplicação)
MYSQL_ROOT_PASSWORD=senha_root_forte_aqui_minimo_32_caracteres

# ============================================
# CACHE E SESSÃO
# ============================================
CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# ============================================
# REDIS (se usar)
# ============================================
REDIS_HOST=redis
REDIS_PASSWORD=senha_redis_forte_aqui
REDIS_PORT=6379

# ============================================
# MAIL
# ============================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.exemplo.com
MAIL_PORT=587
MAIL_USERNAME=seu_email@exemplo.com
MAIL_PASSWORD=sua_senha_email
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@seudominio.com.br
MAIL_FROM_NAME="${APP_NAME}"

# ============================================
# LOGGING
# ============================================
LOG_CHANNEL=stack
LOG_LEVEL=error

# ============================================
# OUTRAS CONFIGURAÇÕES
# ============================================
BROADCAST_DRIVER=log
FILESYSTEM_DISK=local

# ============================================
# SANCTUM (se usar)
# ============================================
SANCTUM_STATEFUL_DOMAINS=seudominio.com.br
